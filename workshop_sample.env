# EvalHub workshop: Workbench configuration for Modules 2-5.
# In the repository root, run: cp -n workshop_sample.env .env
# Edit .env in JupyterLab before opening the setup notebook.
# See docs/workshop-environment.adoc for value discovery and Module 6 additions.

# Data science project used as the EvalHub tenant (provided by your instructor).
NAMESPACE=your-project-name

# OpenAI-compatible model: use the exact served model ID and API base URL.
# Keep /v1 if provided; do not append /chat/completions.
MODEL_NAME=your-served-model-id
MODEL_ENDPOINT=https://your-model-endpoint.example.com/v1
MODEL_API_KEY=

# EvalHub API base URL, without /api/v1; set explicitly for the setup notebook.
# Use an authorized OpenShift token, without the "Bearer " prefix.
# Leave the token empty only if oc whoami -t succeeds in the Workbench.
EVALHUB_URL=https://your-evalhub-route.example.com
EVALHUB_AUTH_TOKEN=

# Use the tracking URI confirmed by your instructor for this cluster.
# This service URL is a common in-cluster value; verify it before use.
MLFLOW_TRACKING_URI=https://mlflow.redhat-ods-applications.svc:8443
